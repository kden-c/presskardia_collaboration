#include <BLEDevice.h>
#include <BLEUtils.h>
#include <BLEServer.h>
#include <ESP32Servo.h>
Servo HeartbeatServo;
int LastPosition = 0;
int BPM = 0;
int StartTime = 0;
int FinalTime = 0;
int lastSignal = 0;
int lastBeat = 0;
#define SERVICE_UUID "67ec9dee-b161-4d77-b2ad-832385086029"
#define TRANSFERCHARACTERISTIC_UUID "6E400003-B5A3-F393-E0A9-E50E24DCCA9E"
#define RECEIVINGCHARACTERISTIC_UUID "6E400002-B5A3-F393-E0A9-E50E24DCCA9E"
BLECharacteristic *pTransferCharacteristic;
BLECharacteristic *pReceivingCharacteristic;
BLEService *pService;
BLEServer *pServer;

void setup() {
Serial.begin(115200);
pinMode(35, INPUT);
pinMode(2, OUTPUT);
pinMode(32, OUTPUT);
HeartbeatServo.attach(32);
BLEDevice::init("PressKardiaCompressionDevice");
pServer = BLEDevice::createServer();
pService = pServer->createService(SERVICE_UUID);

pTransferCharacteristic = pService->createCharacteristic(
  TRANSFERCHARACTERISTIC_UUID,
  BLECharacteristic::PROPERTY_READ |
  BLECharacteristic::PROPERTY_WRITE |
  BLECharacteristic::PROPERTY_NOTIFY

); 
pReceivingCharacteristic = pService->createCharacteristic(
  RECEIVINGCHARACTERISTIC_UUID,
  BLECharacteristic::PROPERTY_READ |
  BLECharacteristic::PROPERTY_WRITE |
  BLECharacteristic::PROPERTY_WRITE_NR |
  BLECharacteristic::PROPERTY_NOTIFY
);

pService->start();
  BLEAdvertising *pAdvertising = pServer->getAdvertising();
  pAdvertising->addServiceUUID(SERVICE_UUID);
  pAdvertising->start(); 
}

void loop() {
if (pServer->getConnectedCount()>0) {
  digitalWrite(2, HIGH);
}
else {
  digitalWrite(2, LOW);
};
int Signal = analogRead(35);
pTransferCharacteristic->setValue(Signal);
pTransferCharacteristic->notify();


String AngleValue = pReceivingCharacteristic->getValue();
int ServoAngle = (int)AngleValue.charAt(0);
Serial.println(ServoAngle);
HeartbeatServo.write(ServoAngle);



}



